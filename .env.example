# Copy to `.env` for local dev (Next.js + drizzle-kit read this).
# For Cloudflare preview (`wrangler dev`) the same values go in `.dev.vars`.

# --- Database ---------------------------------------------------------------
# Local dev: a local Postgres (postgres.js driver is used automatically).
DATABASE_URL="postgres://USER@localhost:5432/virgin_estate"
# Production: a Neon connection string — the neon-http driver is used
# automatically when the host contains "neon.tech".
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Seed admin credentials (used by `pnpm db:seed`). Change before launch.
ADMIN_EMAIL="admin@virginestateagents.co.zw"
ADMIN_PASSWORD="change-me"

# --- Public config ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Mapbox public token (pk.*) — get one at https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Cloudflare Web Analytics beacon token (optional, privacy-friendly traffic)
NEXT_PUBLIC_CF_BEACON_TOKEN=""

# --- Enquiries --------------------------------------------------------------
# No email service is used. Enquiries are saved to the database and read in the
# admin inbox at /admin/enquiries; the visitor is offered a WhatsApp handoff to
# the number in src/lib/constants.ts on submit.

# --- Media storage (R2, production only) ------------------------------------
# In production images are stored via the R2 binding (see wrangler.jsonc).
# These are only needed if you use the S3-compatible API instead of the binding.
R2_PUBLIC_URL=""
